{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "_comment": "Spec-Rails Mutation Testing Rail for JS/TS (Stryker). Target: >= 95% kill score; justify every survivor in the PR.",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts",
    "!src/index.ts"
  ],
  "testRunner": "vitest",
  "reporters": ["progress", "clear-text"],
  "thresholds": {
    "high": 98,
    "low": 95,
    "break": 95
  },
  "concurrency": 4,
  "timeoutMS": 10000
}
