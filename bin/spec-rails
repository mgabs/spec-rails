#!/usr/bin/env sh
# spec-rails [init] [--force] [target-dir]: wire Spec-Rails into an existing OpenSpec project.
set -eu

SPEC_RAILS_VERSION="1.0.0"
MIN_OPENSPEC="1.15.0"

# resolve_script_dir SRC: resolve symlinks on $0 and print physical directory path.
resolve_script_dir() {
  _src="$1"
  case "$_src" in
    */*) ;;
    *) _src="$(command -v -- "$_src" 2>/dev/null || printf '%s' "$_src")" ;;
  esac
  while [ -L "$_src" ]; do
    _dir="$(CDPATH='' cd -- "$(dirname -- "$_src")" && pwd)"
    _link="$(readlink "$_src")"
    case "$_link" in
      /*) _src="$_link" ;;
      *) _src="$_dir/$_link" ;;
    esac
  done
  CDPATH='' cd -- "$(dirname -- "$_src")" && pwd
}

# version_ge A B: succeeds when SemVer A >= B (pre-release < release for equal X.Y.Z).
version_ge() {
  _a="${1%%+*}"
  _b="${2%%+*}"
  _a_num="${_a%%-*}"
  _b_num="${_b%%-*}"
  if [ "$_a_num" = "$_b_num" ]; then
    if [ "$_a" != "$_a_num" ] && [ "$_b" = "$_b_num" ]; then
      return 1
    fi
    if [ "$_a" = "$_a_num" ] && [ "$_b" != "$_b_num" ]; then
      return 0
    fi
    [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort | head -n 1)" = "$_b" ]
    return $?
  fi
  [ "$(printf '%s\n%s\n' "$_a_num" "$_b_num" | sort -t. -k1,1n -k2,2n -k3,3n | head -n 1)" = "$_b_num" ]
}

# reject_symlink BASE DST: fail if BASE or any component from BASE down to DST is a symlink.
reject_symlink() {
  _base="$1"
  _dst="$2"
  while [ "$_base" != "/" ] && [ "${_base%/}" != "$_base" ]; do
    _base="${_base%/}"
  done
  while [ "$_dst" != "/" ] && [ "${_dst%/}" != "$_dst" ]; do
    _dst="${_dst%/}"
  done
  if [ -L "$_base" ]; then
    echo "ERROR: refusing to write through symlink: $_base" >&2
    return 1
  fi
  if [ "$_dst" = "$_base" ]; then
    return 0
  fi
  _rel="${_dst#"$_base"/}"
  if [ "$_rel" = "$_dst" ]; then
    if [ -L "$(dirname -- "$_dst")" ] || [ -L "$_dst" ]; then
      echo "ERROR: refusing to write through symlink: $_dst" >&2
      return 1
    fi
    return 0
  fi
  _cur="$_base"
  while [ -n "$_rel" ]; do
    case "$_rel" in
      */*)
        _part="${_rel%%/*}"
        _rel="${_rel#*/}"
        ;;
      *)
        _part="$_rel"
        _rel=""
        ;;
    esac
    if [ -z "$_part" ] || [ "$_part" = "." ]; then
      continue
    fi
    if [ "$_cur" = "/" ]; then
      _cur="/$_part"
    else
      _cur="$_cur/$_part"
    fi
    if [ -L "$_cur" ]; then
      echo "ERROR: refusing to write through symlink: $_cur" >&2
      return 1
    fi
  done
  return 0
}

# set_schema_line: stdin -> stdout, forcing exactly one "schema: spec-rails" line.
set_schema_line() {
  awk '
    /^schema:/ { if (!done) print "schema: spec-rails"; done = 1; next }
    { print }
    END { if (!done) print "schema: spec-rails" }
  '
}

# put_file SRC DST: copy only when DST is absent or differs.
put_file() {
  if [ -n "${target:-}" ]; then
    reject_symlink "$target" "$2" || return 1
  fi
  if [ ! -f "$2" ] || ! cmp -s "$1" "$2"; then
    mkdir -p "$(dirname -- "$2")"
    cp -- "$1" "$2"
  fi
}

# put_customizable SRC DST: copy only when DST is absent or --force is active.
put_customizable() {
  if [ -n "${target:-}" ]; then
    reject_symlink "$target" "$2" || return 1
  fi
  if [ ! -f "$2" ] || [ "${force:-0}" = 1 ]; then
    put_file "$1" "$2" || return 1
  fi
}

# git_hook_path TARGET: print pre-commit hook path (supports git worktrees).
git_hook_path() {
  _hp="$(git -C "$1" rev-parse --git-path hooks/pre-commit 2>/dev/null || true)"
  if [ -z "$_hp" ]; then
    printf '%s/.git/hooks/pre-commit\n' "$1"
    return 0
  fi
  case "$_hp" in
    /*) printf '%s\n' "$_hp" ;;
    *) printf '%s/%s\n' "$1" "$_hp" ;;
  esac
}

install_hook() {
  hook="$1"
  mkdir -p "$(dirname -- "$hook")"
  cat <<'EOF' > "$hook"
#!/bin/sh
# Spec-Rails Workflow Branch Protection Hook
branch="$(git branch --show-current 2>/dev/null || git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
    echo "ERROR: Direct commits to '$branch' are forbidden by Spec-Rails workflow." >&2
    echo "Please checkout an isolated branch first:" >&2
    echo "  git checkout -b feat/<id>-<name>   (for features)" >&2
    echo "  git checkout -b fix/<slug>          (for bugfixes)" >&2
    echo "  git checkout -b chore/<slug>        (for chores/tooling)" >&2
    exit 1
fi

# Spec-Rails LGTM Directive Preemption Hook
if [ -d ".lgtm/reviews" ]; then
    directives="$(grep -rn "^#ref " .lgtm/reviews 2>/dev/null || true)"
    if [ -n "$directives" ]; then
        echo "ERROR: Unresolved LGTM review directives found in .lgtm/reviews/:" >&2
        echo "$directives" >&2
        echo "Spec-Rails Rule: Review directives preempt all forward work. Resolve and clear them before committing." >&2
        exit 1
    fi
fi

# Spec-Rails Gate & Lane Check (installed by spec-rails)
if [ -f "openspec/spec-rails/spec-rails-check" ]; then
    sh openspec/spec-rails/spec-rails-check || exit 1
fi
EOF
  chmod +x "$hook"
}

# add_check_to_hook HOOK: inject #ref preemption and spec-rails-check into a Bourne hook once.
add_check_to_hook() {
  first="$(head -n 1 "$1")"
  case "$first" in
    '#!'*python*|'#!'*node*|'#!'*ruby*|'#!'*perl*|'#!'*fish*|'#!'*pwsh*|'#!'*php*|'#!'*lua*)
      echo "warning: existing pre-commit hook uses non-sh interpreter; run openspec/spec-rails/spec-rails-check from your hook." >&2
      return 0
      ;;
  esac
  need_lgtm=1
  need_check=1
  grep -q '\.lgtm/reviews' "$1" && need_lgtm=0
  grep -q 'openspec/spec-rails/spec-rails-check' "$1" && need_check=0
  if [ "$need_lgtm" = 0 ] && [ "$need_check" = 0 ]; then
    [ -x "$1" ] || chmod +x "$1"
    return 0
  fi
  tmp="$(mktemp "${TMPDIR:-/tmp}/spec-rails.XXXXXX")" || return 1
  {
    case "$first" in '#!'*) printf '%s\n' "$first"; rest=2 ;; *) rest=1 ;; esac
    if [ "$need_lgtm" = 1 ]; then
      # shellcheck disable=SC2016
      printf '%s\n' \
        '# Spec-Rails LGTM Directive Preemption Hook (installed by spec-rails)' \
        'if [ -d ".lgtm/reviews" ]; then' \
        '    directives="$(grep -rn "^#ref " .lgtm/reviews 2>/dev/null || true)"' \
        '    if [ -n "$directives" ]; then' \
        '        echo "ERROR: Unresolved LGTM review directives found in .lgtm/reviews/:" >&2' \
        '        echo "$directives" >&2' \
        '        exit 1' \
        '    fi' \
        'fi'
    fi
    if [ "$need_check" = 1 ]; then
      printf '%s\n' \
        '# Spec-Rails Gate & Lane Check (installed by spec-rails)' \
        'if [ -f "openspec/spec-rails/spec-rails-check" ]; then' \
        '    sh openspec/spec-rails/spec-rails-check || exit 1' \
        'fi'
    fi
    tail -n +"$rest" "$1"
  } > "$tmp" || { rm -f -- "$tmp"; return 1; }
  cat -- "$tmp" > "$1" || { rm -f -- "$tmp"; return 1; }
  rm -f -- "$tmp"
  chmod +x "$1"
}

main() {
  _script_dir="$(resolve_script_dir "$0")"
  _root="$(CDPATH='' cd -- "$_script_dir/.." && pwd)"

  # Trampoline to bundled Node CLI for verify, lint, or --stack
  if [ "${1:-}" = "verify" ] || [ "${1:-}" = "lint" ]; then
    if [ -f "$_root/dist/cli.js" ] && command -v node >/dev/null 2>&1; then
      exec node "$_root/dist/cli.js" "$@"
    fi
  fi
  case "${*:-}" in
    *--stack*)
      if [ -f "$_root/dist/cli.js" ] && command -v node >/dev/null 2>&1; then
        exec node "$_root/dist/cli.js" "$@"
      fi
      ;;
  esac

  force=0
  target=""
  saw_init=0
  end_opts=0
  while [ $# -gt 0 ]; do
    if [ "$end_opts" = 0 ]; then
      case "$1" in
        -V|--version)
          echo "spec-rails $SPEC_RAILS_VERSION"
          return 0
          ;;
        -h|--help)
          echo "Usage: spec-rails [init] [--force] [target-dir]"
          return 0
          ;;
        -f|--force)
          force=1
          shift
          continue
          ;;
        --)
          end_opts=1
          shift
          continue
          ;;
        -*)
          echo "ERROR: unknown option: $1" >&2
          echo "Usage: spec-rails [init] [--force] [target-dir]" >&2
          return 1
          ;;
      esac
    fi
    if [ "$1" = "init" ] && [ "$saw_init" = 0 ] && [ -z "$target" ] && [ "$end_opts" = 0 ]; then
      saw_init=1
    elif [ -z "$target" ]; then
      target="$1"
    else
      echo "ERROR: unexpected argument: $1" >&2
      echo "Usage: spec-rails [init] [--force] [target-dir]" >&2
      return 1
    fi
    shift
  done

  target="${target:-.}"
  while [ "$target" != "/" ] && [ "${target%/}" != "$target" ]; do
    target="${target%/}"
  done

  script_dir="$(resolve_script_dir "$0")"
  root="$(CDPATH='' cd -- "$script_dir/.." && pwd)"
  if [ ! -d "$root/schemas/spec-rails" ] || [ ! -d "$root/templates" ] || [ ! -f "$root/skills/spec-rails/SKILL.md" ]; then
    echo "ERROR: Spec-Rails source assets not found under $root." >&2
    return 1
  fi

  reject_symlink "$target" "$target" || return 1

  if [ ! -d "$target/openspec" ]; then
    echo "ERROR: $target/openspec not found. Run 'openspec init' first." >&2
    return 1
  fi

  version="$(openspec --version 2>/dev/null | tr ' \t/' '\n' | sed -n 's/^[^0-9]*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\(-[A-Za-z0-9.-]*\)\{0,1\}\).*/\1/p' | head -n 1 || true)"
  if [ -z "$version" ] || ! version_ge "$version" "$MIN_OPENSPEC"; then
    echo "ERROR: OpenSpec >= $MIN_OPENSPEC is required on PATH (found: ${version:-none})." >&2
    return 1
  fi

  schema_files="$(cd "$root/schemas/spec-rails" && find . -type f)" || return 1
  [ -n "$schema_files" ] || {
    echo "ERROR: no schema files found under $root/schemas/spec-rails." >&2
    return 1
  }
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    f="${f#./}"
    put_file "$root/schemas/spec-rails/$f" "$target/openspec/schemas/spec-rails/$f" || return 1
  done <<EOF
$schema_files
EOF

  config="$target/openspec/config.yaml"
  reject_symlink "$target" "$config" || return 1
  cfg_tmp="$(mktemp "${TMPDIR:-/tmp}/spec-rails.XXXXXX")" || return 1
  if [ -f "$config" ]; then
    prev="$(sed -n 's/^schema:[[:space:]]*//p' "$config" | head -n 1 | sed -e 's/[[:space:]]*#.*$//' -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/")"
    set_schema_line < "$config" > "$cfg_tmp" || { rm -f -- "$cfg_tmp"; return 1; }
  else
    prev=""
    set_schema_line < /dev/null > "$cfg_tmp" || { rm -f -- "$cfg_tmp"; return 1; }
  fi
  if [ ! -f "$config" ] || ! cmp -s "$cfg_tmp" "$config"; then
    cat -- "$cfg_tmp" > "$config" || { rm -f -- "$cfg_tmp"; return 1; }
  fi
  rm -f -- "$cfg_tmp"
  if [ -n "$prev" ] && [ "$prev" != "spec-rails" ]; then
    echo "Replaced previous schema '$prev' with 'spec-rails' in openspec/config.yaml"
  fi

  put_customizable "$root/templates/.pre-commit-config.yaml" "$target/.pre-commit-config.yaml" || return 1
  put_customizable "$root/templates/spec-rails-ci.yml" "$target/.github/workflows/spec-rails-ci.yml" || return 1
  put_file "$root/templates/bug-report.md" "$target/openspec/spec-rails/bug-report.md" || return 1
  for m in "$root/templates/mutation/"*; do
    [ -f "$m" ] || continue
    put_customizable "$m" "$target/openspec/spec-rails/mutation/$(basename -- "$m")" || return 1
  done
  put_file "$root/rules/AGENTS.md" "$target/openspec/spec-rails/AGENTS.md" || return 1
  put_file "$root/rules/WORKFLOW.md" "$target/openspec/spec-rails/WORKFLOW.md" || return 1
  put_file "$root/skills/spec-rails/SKILL.md" "$target/.agents/skills/spec-rails/SKILL.md" || return 1
  put_file "$root/bin/spec-rails-check" "$target/openspec/spec-rails/spec-rails-check" || return 1
  chmod +x "$target/openspec/spec-rails/spec-rails-check"
  put_file "$root/bin/spec-rails-verify" "$target/openspec/spec-rails/spec-rails-verify" || return 1
  chmod +x "$target/openspec/spec-rails/spec-rails-verify"
  put_customizable "$root/templates/rails.conf" "$target/openspec/spec-rails/rails.conf" || return 1

  reject_symlink "$target" "$target/.gitignore" || return 1
  if [ -f "$target/.gitignore" ]; then
    grep -qxF ".worktrees/" "$target/.gitignore" || printf "\n.worktrees/\n" >> "$target/.gitignore"
  else
    printf ".worktrees/\n" > "$target/.gitignore"
  fi

  if [ -L "$target/.git" ]; then
    echo "ERROR: refusing to write through symlink: $target/.git" >&2
    return 1
  elif [ ! -e "$target/.git" ]; then
    echo "warning: $target is not a git repository; skipping git hook." >&2
  else
    hook="$(git_hook_path "$target")"
    hook_dir="$(dirname -- "$hook")"
    if [ -L "$hook_dir" ] || [ -L "$hook" ]; then
      echo "ERROR: refusing to write through symlink: $hook" >&2
      return 1
    fi
    reject_symlink "$target" "$hook" || return 1
    if [ ! -f "$hook" ]; then
      install_hook "$hook" || return 1
    else
      add_check_to_hook "$hook" || return 1
    fi
  fi

  echo "Spec-Rails wired into $target/openspec/ (schema: spec-rails)"
}

if [ -z "${SPEC_RAILS_SOURCE_ONLY:-}" ]; then
  main "$@"
fi
